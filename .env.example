# --- LLM provider: "openai" or "huggingface" ---
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-R1:fastest
HF_BASE_URL=https://router.huggingface.co/v1

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800

# --- Tools ---
OPENWEATHERMAP_API_KEY=
# Optional: if unset, web_search falls back to DuckDuckGo (no key needed)
TAVILY_API_KEY=

# --- Agent behavior ---
MAX_AGENT_ITERATIONS=6
REQUEST_TIMEOUT_SECONDS=20

# --- RAG tool ---
RAG_DATA_DIR=data/sample_docs
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-assistant
LOG_LEVEL=INFO
